ENVIRONMENT=development
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=spaceweave_products
EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
EMBEDDING_DIM=512
CANDIDATE_K=120
DEFAULT_TOP_K=8
SPATIAL_CLEARANCE_CM=10
MAX_UPLOAD_MB=10
SEED_CATALOG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Live marketplace/search integrations. Keep secrets server-side only.

# Primary — SerpApi (Google Shopping). No affiliate approval needed, just
# an API key: https://serpapi.com/manage-api-key
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_GL=in
SERPAPI_HL=en

# Secondary — Flipkart Affiliate API. Requires an approved affiliate
# account: https://affiliate.flipkart.com
FLIPKART_ENABLED=false
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Tertiary — Amazon Creators API (successor to PA-API 5.0, retired
# 2026-05-15). Requires an approved Associates account with active
# Creators API access: https://affiliate-program.amazon.com/creatorsapi
AMAZON_ENABLED=false
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
